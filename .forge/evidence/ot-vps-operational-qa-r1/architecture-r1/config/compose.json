{
  "name": "devtestportal",
  "networks": {
    "database": {
      "name": "one-talibon_database",
      "ipam": {},
      "external": true
    },
    "internal": {
      "name": "devtestportal_internal",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "app": {
      "restart": "unless-stopped",
      "cpus": 2,
      "command": null,
      "entrypoint": null,
      "env_file": [
        {
          "path": "/opt/devtestportal/infra/private/app.env",
          "required": true,
          "format": "raw"
        }
      ],
      "image": "sha256:c3b1a3ea74f104ee7cb83d287fbf82773898fa0b65ed4946a92dd72ca3b9b062",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "2147483648",
      "memswap_limit": "2147483648",
      "networks": {
        "database": null,
        "internal": null
      },
      "pids_limit": 256,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "33:33",
      "volumes": [
        {
          "type": "volume",
          "source": "iam_storage",
          "target": "/var/www/html/storage",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/opt/devtestportal/infra/postgres-ca.crt",
          "target": "/run/one-talibon/postgres-ca.crt",
          "read_only": true
        },
        {
          "type": "volume",
          "source": "bootstrap_cache",
          "target": "/var/www/html/bootstrap/cache"
        }
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:uid=33,gid=33,mode=1777",
        "/var/run/apache2:uid=33,gid=33,mode=0750",
        "/var/lock/apache2:uid=33,gid=33,mode=0750"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "--fail",
          "--silent",
          "http://127.0.0.1/up"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "20s"
      }
    },
    "caddy": {
      "restart": "unless-stopped",
      "cap_add": [
        "NET_BIND_SERVICE"
      ],
      "cap_drop": [
        "ALL"
      ],
      "cpus": 1,
      "command": null,
      "entrypoint": null,
      "image": "caddy@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "268435456",
      "memswap_limit": "268435456",
      "networks": {
        "internal": {
          "ipv4_address": "172.18.0.4"
        }
      },
      "pids_limit": 128,
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/opt/devtestportal/infra/Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "volume",
          "source": "caddy_data",
          "target": "/data",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "caddy_config",
          "target": "/config",
          "volume": {}
        }
      ],
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "80",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "udp"
        }
      ]
    },
    "db": {
      "restart": "unless-stopped",
      "cpus": 2,
      "command": [
        "postgres",
        "-c",
        "ssl=on",
        "-c",
        "ssl_cert_file=/etc/one-talibon/tls/server.crt",
        "-c",
        "ssl_key_file=/etc/one-talibon/tls/server.key",
        "-c",
        "ssl_min_protocol_version=TLSv1.2",
        "-c",
        "hba_file=/etc/one-talibon/pg_hba.conf"
      ],
      "entrypoint": null,
      "env_file": [
        {
          "path": "/opt/devtestportal/infra/private/postgres.env",
          "required": true,
          "format": "raw"
        }
      ],
      "image": "postgres@sha256:5264710be20f409750ac6dc4e5706dcef929c87e241605463f0f9aefa932a8d9",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "4294967296",
      "memswap_limit": "4294967296",
      "networks": {
        "database": {
          "aliases": [
            "db"
          ]
        }
      },
      "pids_limit": 256,
      "volumes": [
        {
          "type": "volume",
          "source": "db_data",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/opt/devtestportal/infra/postgres-tls",
          "target": "/etc/one-talibon/tls",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "/opt/devtestportal/infra/postgres-ca.crt",
          "target": "/etc/one-talibon/ca.crt",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "/opt/devtestportal/infra/pg_hba.conf",
          "target": "/etc/one-talibon/pg_hba.conf",
          "read_only": true
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U one_talibon_app -d one_talibon_iam_20261110235520"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 5
      }
    }
  },
  "volumes": {
    "caddy_config": {
      "name": "devtestportal_caddy_config",
      "external": true
    },
    "caddy_data": {
      "name": "devtestportal_caddy_data",
      "external": true
    },
    "db_data": {
      "name": "devtestportal_db_data",
      "external": true
    },
    "iam_storage": {
      "name": "devtestportal_iam_storage",
      "external": true
    },
    "bootstrap_cache": {
      "name": "devtestportal_bootstrap_cache"
    }
  }
}
