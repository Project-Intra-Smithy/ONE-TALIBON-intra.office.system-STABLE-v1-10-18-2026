{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-start.ps1",
    "dev:stack:pull": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-start.ps1 -Pull",
    "dev:stack:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-stop.ps1",
    "build": "vite build",
    "types:check": "tsc --noEmit",
    "test:aj-home-auth": "node --test tests/Browser/aj-home-auth.test.mjs",
    "test:ux": "node --experimental-strip-types --test tests/Browser/ux-refinement.test.mjs",
    "test:contracts": "node --experimental-strip-types --test tests/Frontend/*.test.mjs"
  },
  "dependencies": {
    "@inertiajs/react": "^3.0.0",
    "@inertiajs/vite": "^3.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "laravel-vite-plugin": "^3.0.0",
    "playwright": "1.55.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0"
  },
  "packageManager": "npm@10.9.2"
}
