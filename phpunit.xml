<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!--
                P08 canonical blocking suite. Deferred full-HRIS and specialized
                domain suites remain executable below but do not decide the
                municipality-wide shared-core baseline.
            -->
            <exclude>tests/Feature/H4SystemAdminActionCompletenessTest.php</exclude>
            <exclude>tests/Feature/LeaveCreditTest.php</exclude>
            <exclude>tests/Feature/M6ExecutivePrototypeTest.php</exclude>
            <exclude>tests/Feature/Phase1DevelopmentHealthSecurityTest.php</exclude>
            <exclude>tests/Feature/Phase1DtrPayrollIntegrationTest.php</exclude>
            <exclude>tests/Feature/Phase1ExecutiveLegislativeWorkspaceTest.php</exclude>
            <exclude>tests/Feature/Phase1IntegratedAcceptanceTest.php</exclude>
            <exclude>tests/Feature/Phase1LifecyclePropertyDomainTest.php</exclude>
            <exclude>tests/Feature/Phase1LifecyclePropertyHttpTest.php</exclude>
            <exclude>tests/Feature/Phase1OffboardingTest.php</exclude>
            <exclude>tests/Feature/Phase1PropertyInventoryIntegrityTest.php</exclude>
            <exclude>tests/Feature/Phase1PropertyLifecycleTest.php</exclude>
            <exclude>tests/Feature/PrototypeMessaging/PrototypeMessagingDemoSeederTest.php</exclude>
            <exclude>tests/Feature/TravelOrderDomainTest.php</exclude>
            <exclude>tests/Feature/TravelOrderRecordsFederationTest.php</exclude>
            <exclude>tests/Feature/TravelOrderRepresentativeRoleTest.php</exclude>
            <exclude>tests/Feature/TravelOrderWorkspaceTest.php</exclude>
            <exclude>tests/Feature/WorkforceShowcasePersonaTest.php</exclude>
        </testsuite>
        <testsuite name="DeferredAndSpecialized">
            <file>tests/Feature/H4SystemAdminActionCompletenessTest.php</file>
            <file>tests/Feature/LeaveCreditTest.php</file>
            <file>tests/Feature/M6ExecutivePrototypeTest.php</file>
            <file>tests/Feature/Phase1DevelopmentHealthSecurityTest.php</file>
            <file>tests/Feature/Phase1DtrPayrollIntegrationTest.php</file>
            <file>tests/Feature/Phase1ExecutiveLegislativeWorkspaceTest.php</file>
            <file>tests/Feature/Phase1IntegratedAcceptanceTest.php</file>
            <file>tests/Feature/Phase1LifecyclePropertyDomainTest.php</file>
            <file>tests/Feature/Phase1LifecyclePropertyHttpTest.php</file>
            <file>tests/Feature/Phase1OffboardingTest.php</file>
            <file>tests/Feature/Phase1PropertyInventoryIntegrityTest.php</file>
            <file>tests/Feature/Phase1PropertyLifecycleTest.php</file>
            <file>tests/Feature/PrototypeMessaging/PrototypeMessagingDemoSeederTest.php</file>
            <file>tests/Feature/TravelOrderDomainTest.php</file>
            <file>tests/Feature/TravelOrderRecordsFederationTest.php</file>
            <file>tests/Feature/TravelOrderRepresentativeRoleTest.php</file>
            <file>tests/Feature/TravelOrderWorkspaceTest.php</file>
            <file>tests/Feature/WorkforceShowcasePersonaTest.php</file>
        </testsuite>
        <testsuite name="HistoricalFullHrisContracts">
            <!-- Executable evidence for intentionally withdrawn private-HRIS behavior. -->
            <directory>tests/HistoricalContracts</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="file" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="talibon_portal_test" force="true"/>
        <env name="DB_USERNAME" value="postgres" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
